{
  "name": "preact-widget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode production && cp ./widget.json ./dist",
    "build:prod": "tsc -b && vite build --config vite.config.prod.ts --mode production && cp ./widget.json ./dist",
    "build:analyze": "tsc -b && vite build --mode production && npx vite-bundle-analyzer dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "build:css": "npx @tailwindcss/cli -i ./src/assets/css/app.css -o ./dist/widget-iframe.css",
    "build:widget": "rollup -c ./rollup.config.mjs",
    "build:widget:production": "rollup -c ./rollup.config.mjs --environment=production",
    "serve": "npx http-server ./test --cors -p 3333",
    "serve:widget": "npx http-server ./dist --cors -p 3334"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "deepmerge": "^4.3.1",
    "preact": "^10.24.3",
    "smooth-scrollbar-react": "^2.4.1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.17.0",
    "@preact/preset-vite": "^2.9.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.1",
    "prettier": "3.4.2",
    "rollup": "^4.29.1",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.10",
    "tslib": "^2.8.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "bracketSpacing": true,
    "jsxSingleQuote": true,
    "printWidth": 80
  }
}
